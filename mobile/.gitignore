# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key

# Firebase / Google **service account** keys. These download as ordinary .json,
# which the patterns above don't catch — and `google-services.json` sitting
# committed next door establishes .json under mobile/ as a normal, committable
# file, so nothing else would stop one being added by mistake.
#
# The distinction matters: `google-services.json` is client config that ships in
# every APK and is deliberately committed. A service-account key can **send push
# to every family device under this app's identity**. It belongs on EAS and
# nowhere else. See docs/mobile-release.md.
*-firebase-adminsdk-*.json
*service-account*.json
google-service-account*.json
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files. `.env` is a personal override (e.g. pointing at a local
# Django); `.env.example` is committed and documents what can go in it.
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
